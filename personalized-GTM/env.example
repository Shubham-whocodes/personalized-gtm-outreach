# Required for research and drafting (copy to .env and fill in values).
FIRECRAWL_API_KEY=
EXA_API_KEY=
GEMINI_API_KEY=

# App port inside the container (default 8765).
PORT=8765

# Host port published by Docker Compose (default 8765).
HOST_PORT=8765

# Optional: public HTTPS demo (username is always "demo").
# PUBLIC_ORIGIN must be https://your-hostname with no path.
# DEMO_PASSWORD must be at least 16 characters.
# PUBLIC_ORIGIN=https://demo.example.com
# DEMO_PASSWORD=change-me-16-chars-min
